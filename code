# Ex. 1.1.4: Computing sqrt(n)

def sqrt_n(n):
    x = n
    y = 1
    epsilon = 0.000001

    while x - y > epsilon:
        x = (x + y) / 2
        y = n / x

    return x


# Ex. 1.1.5: Quadratic Roots

def quadratic_roots(a, b, c):
    if a == 0:
        return -c / b

    D = b * b - 4 * a * c

    if D < 0:
        return "Нет действительных корней"

    if D == 0:
        return -b / (2 * a)

    root1 = (-b + sqrt_n(D)) / (2 * a)
    root2 = (-b - sqrt_n(D)) / (2 * a)

    return root1, root2


# Ex. 1.1.6: Binary Representation

def dec_to_bin(n):
    binary_str = ""

    while n > 0:
        remainder = n % 2
        binary_str = str(remainder) + binary_str
        n = n // 2

    return binary_str


# Ex. 1.1.7: ATM Cash Dispensing

def dispense_cash(amount):
    denominations = [10000, 5000, 2000, 1000, 500, 200, 100]
    result = []

    for d in denominations:
        count = amount // d

        if count > 0:
            result.append((count, d))
            amount = amount % d

    if amount > 0:
        return "Ошибка: невозможно выдать запрошенную сумму"

    return result


# Ex. 1.1.8: Closest Elements in Array

def closest_pair_dist(A):
    A.sort()
    min_dist = float("inf")

    for i in range(len(A) - 1):
        if A[i + 1] - A[i] < min_dist:
            min_dist = A[i + 1] - A[i]

    return min_dist


# Ex. 1.1.9: Array Operations

def find_max(A):
    max_val = A[0]

    for i in range(1, len(A)):
        if A[i] > max_val:
            max_val = A[i]

    return max_val


def calculate_average(A):
    if len(A) == 0:
        return 0

    total = 0

    for i in range(len(A)):
        total += A[i]

    return total / len(A)


